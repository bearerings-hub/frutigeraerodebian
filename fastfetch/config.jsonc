{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/aero-leaf.txt",
        "color": {
            "1": "green",
            "2": "cyan"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },

    "display": {
        "separator": "  󰁔  ",
        "color": {
            "keys":   "green",
            "title":  "cyan",
            "output": "white"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "\u001b[32m{user}\u001b[0m\u001b[36m@\u001b[0m\u001b[32m{host}\u001b[0m"
        },
        "separator",
        { "type": "os",      "key": "󰣇  OS      " },
        { "type": "kernel",  "key": "  Kernel  " },
        { "type": "de",      "key": "󰧨  DE      " },
        { "type": "wm",      "key": "  WM      " },
        { "type": "shell",   "key": "  Shell   " },
        { "type": "term",    "key": "  Term    " },
        "separator",
        { "type": "cpu",     "key": "  CPU     " },
        { "type": "gpu",     "key": "󰍛  GPU     " },
        { "type": "memory",  "key": "  RAM     " },
        { "type": "disk",    "key": "󰋊  Disk    " },
        "separator",
        { "type": "uptime",  "key": "󰔚  Uptime  " },
        { "type": "colors",  "paddingLeft": 2 }
    ]
}
